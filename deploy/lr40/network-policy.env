# Параметры сетевой политики ЛР 40 (не секрет).
# Значения ниже – пример. Замените на фактические адреса вашего стенда.
LAB_IF="enp0s8"              # Host-only интерфейс Linux-VM
VM_LAB_IP="192.168.56.10"    # IPv4 Host-only интерфейса VM (опубликованный адрес)
PUBLISHED_PORT="8080"        # опубликованный порт приложения (app:8000)
CLIENT_IP="192.168.56.1"     # IPv4 разрешённого Windows-host (/32)
