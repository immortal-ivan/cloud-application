[Unit]
Description=Cloud Application (LR36, неконтейнеризированное развертывание)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cloudapp
Group=cloudapp
WorkingDirectory=/opt/cloud-application/app
EnvironmentFile=/etc/cloud-application/cloud-application.env
ExecStart=/opt/cloud-application/venv/bin/python run.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
