# Копия этого файла сохраняется как .env (файл .env в Git не попадает).
APP_NAME=Cloud Application
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloud_app
DB_USER=cloud_user
# Пароль БД хранится в secrets/db_password, а не здесь.
# DATABASE_URL=sqlite:///./dev.db   # запасной вариант без PostgreSQL

TOKEN_TTL_MINUTES=60
MAX_UPLOAD_MB=5

HOST=127.0.0.1
PORT=8443
HTTPS_ENABLED=true

# Адрес внутреннего Notification Service (не секрет)
NOTIFICATION_SERVICE_URL=http://127.0.0.1:9000
